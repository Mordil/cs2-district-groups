#!/usr/bin/env bash
# Wraps the mod's build pipeline (dotnet build for C#, webpack for the UI
# bundle), both of which live on the Windows side and have to run through
# cmd.exe from WSL.
#
# Usage: ./build [full|ui|code] [-n] [-r]
#   full   C# + UI, the normal end-to-end build. Default if omitted.
#   code   C# only - skips the UI (webpack) rebuild.
#   ui     UI only - skips dotnet build entirely.
#   -n     Build without deploying to the game's Mods folder. For the C# side
#          this is -p:SkipDeploy=true. webpack itself has no build-only mode
#          - it always writes straight into the deployed Mods folder (see
#          OUTPUT_DIR in src/UI/webpack.config.js) - so -n substitutes a
#          `tsc --noEmit` type-check instead of running webpack, on `ui` or
#          `full`. That's a real, if partial, substitute: it catches type/
#          syntax errors but not anything webpack-specific (loaders, asset
#          resolution, bundling).
#   -r     Build the C# side with `-c Release`, for locally testing release
#          builds. No effect on the UI - webpack already always builds in
#          production mode (see `mode: "production"` in webpack.config.js).
set -euo pipefail

MODE=""
NO_DEPLOY=0
RELEASE=0

usage() {
    echo "Usage: $0 [full|ui|code] [-n] [-r]" >&2
    exit 1
}

for arg in "$@"; do
    case "$arg" in
        full|ui|code) MODE="$arg" ;;
        -n) NO_DEPLOY=1 ;;
        -r) RELEASE=1 ;;
        *) usage ;;
    esac
done

[[ -z "$MODE" ]] && MODE="full"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

build_code() {
    local config=""
    if [[ "$RELEASE" -eq 1 ]]; then
        config="-c Release"
    fi
    local props="-p:SkipUIBuild=true"
    if [[ "$NO_DEPLOY" -eq 1 ]]; then
        props="$props -p:SkipDeploy=true"
    fi
    echo "==> Building code (no deploy: $NO_DEPLOY, release: $RELEASE)"
    cmd.exe /c "dotnet build $config $props"
}

typecheck_ui() {
    echo "==> Type-checking UI (tsc --noEmit, no webpack/deploy)"
    cmd.exe /c "set PATH=C:\Program Files\nodejs;%PATH% && cd src\\UI && node_modules\\.bin\\tsc --noEmit -p tsconfig.json"
}

build_full() {
    local config=""
    if [[ "$RELEASE" -eq 1 ]]; then
        config="-c Release"
    fi
    if [[ "$NO_DEPLOY" -eq 1 ]]; then
        echo "==> Building full (no deploy, release: $RELEASE)"
        cmd.exe /c "dotnet build $config -p:SkipDeploy=true -p:SkipUIBuild=true"
        typecheck_ui
        return
    fi
    echo "==> Building full (release: $RELEASE)"
    cmd.exe /c "dotnet build $config"
}

build_ui() {
    if [[ "$NO_DEPLOY" -eq 1 ]]; then
        typecheck_ui
        return
    fi
    echo "==> Building UI"
    cmd.exe /c "cd src\\UI && build-ui.bat"
}

case "$MODE" in
    code) build_code ;;
    ui) build_ui ;;
    full) build_full ;;
esac
