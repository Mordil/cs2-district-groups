<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Configurations>Debug;Release</Configurations>

        <!--Keep in step with ModVersion in PublishConfiguration.xml and version in src/UI/mod.json-->
        <Version>0.4.0</Version>

        <!--The file where mod information which is required for publishing mod on PDX mods are stored-->
        <PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
    </PropertyGroup>

    <!--Imports must be after PropertyGroup block-->
    <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props"/>
    <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets"/>

    <ItemGroup>
        <Reference Include="Game">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Core">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Logging">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Mathematics">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.IO.AssetDatabase">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.UI">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.UI.Binding">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Localization">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.InputSystem">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Burst">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Collections">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Entities">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Mathematics">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Reference Update="System">
            <Private>false</Private>
        </Reference>
        <Reference Update="System.Core">
            <Private>false</Private>
        </Reference>
        <Reference Update="System.Data">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(ModPropsFile)" Link="Properties\Mod.props"/>
        <None Include="$(ModTargetsFile)" Link="Properties\Mod.targets"/>
    </ItemGroup>

    <!--Override (same target name, per Mod.targets' own documented extension
        point): -p:SkipDeploy=true compiles/post-processes the DLL fully but
        skips copying it into the game's Mods folder - lets `build` (see the
        `-n` flag of the root build script) verify the mod still compiles
        without touching a copy the running game might have locked.-->
    <Target Name="DeployWIP" AfterTargets="AfterBuild" Condition="'$(NeedBuild)' and '$(SkipDeploy)' != 'true'">
        <ItemGroup>
            <FilesToDeploy Include="$(OutDir)\**\*.*"/>
        </ItemGroup>
        <Message Text="Copy output to deploy directory $(DeployDir)" Importance="high"/>
        <RemoveDir Directories="$(DeployDir)"/>
        <Copy SourceFiles="@(FilesToDeploy)" DestinationFiles="@(FilesToDeploy->'$(DeployDir)\%(RecursiveDir)%(Filename)%(Extension)')"/>
    </Target>

    <!--The deploy step wipes the Mods folder, deleting the UI bundle webpack put
        there - so rebuild the UI after every deploy. UI-only iteration can still
        use 'npm run dev' in UI/ for hot reload without touching the C# build.
        -p:SkipUIBuild=true (the build script's `code` mode) skips this so a
        C#-only check doesn't wait on a webpack rebuild. Also skipped whenever
        SkipDeploy is set: webpack writes straight into the Mods folder (see
        OUTPUT_DIR in webpack.config.js) - there's no build-without-deploy for it.-->
    <Target Name="BuildUIModule" AfterTargets="DeployWIP" Condition="'$(SkipUIBuild)' != 'true' and '$(SkipDeploy)' != 'true'">
        <Exec Command="&quot;$(MSBuildProjectDirectory)\src\UI\build-ui.bat&quot;" WorkingDirectory="$(MSBuildProjectDirectory)\src\UI"/>
    </Target>

    <!--Custom SVG icons served to the UI over coui://districtgroups/ (the host is
        registered in Mod.OnLoad). The deploy step wipes the Mods folder, so - like
        the UI bundle above - these have to be re-copied after every deploy. Pattern
        is the one documented in the toolchain's Mod.targets header. Skipped
        alongside the DLL under SkipDeploy, since this is a Mods-folder copy too.-->
    <Target Name="DeployIcons" AfterTargets="DeployWIP" Condition="'$(SkipDeploy)' != 'true'">
        <ItemGroup>
            <IconFilesToDeploy Include="$(MSBuildProjectDirectory)\Icons\**\*.svg"/>
        </ItemGroup>
        <Copy SourceFiles="@(IconFilesToDeploy)"
              DestinationFiles="@(IconFilesToDeploy->'$(DeployDir)\Icons\%(RecursiveDir)%(Filename)%(Extension)')"/>
    </Target>

</Project>
